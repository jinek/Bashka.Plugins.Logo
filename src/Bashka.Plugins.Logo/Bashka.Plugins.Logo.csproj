<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!--Bashka will search for this assembly by NUGET package name-->
        <PackageId>$(AssemblyName)</PackageId>
        <Version>1.0.0</Version>
        <Description>Demonstration plugin for Bashka showing how to register a visual extension, load Avalonia styles, and display an embedded ANSI BASHKA logo in the About view.</Description>
        <!--Bashka will search for plugin by this tag-->
        <PackageTags>bashka-plugin</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <UseAppHost>false</UseAppHost>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bashka.Plugins" Version="1.0.3" ExcludeAssets="runtime"/>
        <PackageReference Include="Bashka.Launcher" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="readme.md" Pack="true" PackagePath="/"/>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Assets\"/>
        <AvaloniaResource Include="Assets\Bashka.ans"/>
    </ItemGroup>
</Project>